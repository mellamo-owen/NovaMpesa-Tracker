<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#F0F4F8">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter Your Name" android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="First Name"/>
    <Button android:id="@+id/btnSaveName" android:layout_width="match_parent" android:layout_height="56dp" android:text="Start" android:layout_marginTop="24dp" android:backgroundTint="#00E676" android:textColor="#000000"/>
</LinearLayout>
