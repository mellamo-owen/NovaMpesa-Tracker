<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">
            
            <ImageView
                android:id="@+id/imgHomeBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_home" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="80dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="6"/>
                
            <TextView
                android:id="@+id/tvTrialBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00E676"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Trial Active"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_gravity="bottom"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="24dp"
                android:elevation="4dp"/>

            <ImageView
                android:id="@+id/btnThemeColor"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="#66000000"
                app:tint="#FFFFFF"
                android:elevation="4dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp" />
        </FrameLayout>

        <!-- Totals Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="-16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="#FFFFFF">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spent This Week" android:textColor="#757575" android:textSize="14sp"/>
                <TextView android:id="@+id/tvWeekTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ksh 0.00" android:textColor="#D32F2F" android:textSize="32sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginVertical="16dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spent This Month" android:textColor="#757575" android:textSize="14sp"/>
                <TextView android:id="@+id/tvMonthTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ksh 0.00" android:textColor="#D32F2F" android:textSize="32sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- External Deposits Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:background="#0A1C3A">
                <TextView
                    android:id="@+id/tvExternalDeposits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="External Deposits: Ksh 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Loans Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:background="#0A1C3A">
                <TextView
                    android:id="@+id/tvLoansOwed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owed to You: Ksh 0.00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Runway Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center"
                android:background="#0A1C3A">
                <TextView
                    android:id="@+id/tvRunway"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="M-Pesa Runway: Calculating..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bar Chart Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#0A1C3A">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Spending" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <com.novanest.mpesatracker.BarChartView
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
