<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F4F8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subscription Required" android:textSize="24sp" android:textStyle="bold" android:textColor="#E53935" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your 60-day free trial has expired." android:textSize="16sp" android:textColor="#000000" android:layout_marginBottom="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your Device ID:" android:textStyle="bold" android:textColor="#000000" />
        <TextView android:id="@+id/tvDeviceId" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="..." android:textSize="18sp" android:textColor="#0A1C3A" android:textStyle="bold" android:padding="12dp" android:background="#E0E0E0" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment Details (M-Pesa):" android:textStyle="bold" android:textColor="#000000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pay KES 100 via M-Pesa to:\n\nPhone Number: 0182647623\nAccount Name: Mickowen Khaseke\n\nAfter paying, send your screenshot and Device ID to WhatsApp: 0182647623" android:padding="12dp" android:background="#E0E0E0" android:textColor="#000000" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Enter Activation Code">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etActivationCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>
        <Button android:id="@+id/btnActivate" android:layout_width="match_parent" android:layout_height="56dp" android:text="Activate App" android:textColor="#000000" android:layout_marginTop="16dp" android:backgroundTint="#00E676" />
        <Button android:id="@+id/btnExit" android:layout_width="match_parent" android:layout_height="56dp" android:text="Exit App" android:layout_marginTop="8dp" android:textColor="#000000" android:backgroundTint="#9E9E9E" />
    </LinearLayout>
</ScrollView>
